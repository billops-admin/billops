# BillOps configuration
# Copy to .env.local (or .env) and adjust.

# Shared secret for the scheduled endpoints (/api/cron/daily, /api/worker/email).
# Required in production. Leave empty in local development to disable the check.
CRON_SECRET=change-this-to-a-random-secret

# Database file. Defaults to ./data/billops.db
BILLOPS_DB_PATH=

# Local mailbox directory for the console email provider.
# Defaults to ./data/outbox (or next to BILLOPS_DB_PATH when set).
BILLOPS_OUTBOX_DIR=

# Set to "true" only if you want the demo bills inserted into an empty database.
BILLOPS_SEED_DEMO=false

# Seed admin account (only used when the database is created for the first time).
# BILLOPS_ADMIN_PASSWORD is required in production and must be a strong password.
BILLOPS_ADMIN_EMAIL=admin@billops.local
BILLOPS_ADMIN_PASSWORD=change-this-to-a-strong-password
BILLOPS_ADMIN_NAME=BillOps Admin

# On an empty database, seed the real bill catalog and recipient flow.
# Set to "true" on a fresh deployment; existing databases are never modified.
BILLOPS_SEED_CATALOG=false

# Email delivery: "console" writes .eml files to ./data/outbox (default).
# "smtp" uses a Gmail app password or another SMTP account.
# "gmail" uses the Gmail API with the OAuth credentials below.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
